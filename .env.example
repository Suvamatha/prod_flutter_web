# Browser-safe Supabase values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
VITE_API_URL=/api
VITE_SHARE_ORIGIN=http://localhost:3000
VITE_SHOW_SAMPLES=false

# Vercel server functions (never expose these with VITE_ prefixes)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY

# FlutterShow-owned GitHub repository and fine-grained token
PLATFORM_GITHUB_REPO=YOUR_GITHUB_USERNAME/fluttershow
PLATFORM_GITHUB_TOKEN=YOUR_FINE_GRAINED_TOKEN
PLATFORM_BUILD_WORKFLOW=build-demo.yml

# Abuse protection
MAX_BUILDS_PER_USER_PER_DAY=5
MAX_CONCURRENT_BUILDS_PER_USER=1
